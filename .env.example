MIHOMO_URL=http://192.168.1.1:9090
MIHOMO_SECRET=
POLL_INTERVAL_SECONDS=5
CAPTURE_MODE=leak_rule
LEAK_RULE_PAYLOADS=漏网之鱼,MATCH
ANALYZE_INTERVAL_SECONDS=60
ANALYZE_CONCURRENCY=4
DIRECT_PROBE_TIMEOUT_SECONDS=5
AUTO_DIRECT_SCORE=0.85
GEOIP_DB_PATH=/geoip/GeoLite2-Country.mmdb
GEOIP_CITY_DB_PATH=/geoip/GeoLite2-City.mmdb
GEOIP_COUNTRY_URL=https://testingcf.jsdelivr.net/gh/MetaCubeX/meta-rules-dat@release/country.mmdb
GEOIP_CITY_URL=https://github.com/P3TERX/GeoLite.mmdb/releases/latest/download/GeoLite2-City.mmdb
AUTO_DOWNLOAD_GEOIP=1
ONLINE_GEO_LOOKUP=1
GEO_LOOKUP_URL=http://ip-api.com/json/{ip}?lang=zh-CN&fields=status,message,country,countryCode,regionName,city
DATABASE_PATH=/data/routecheck.db
TZ=Asia/Shanghai
